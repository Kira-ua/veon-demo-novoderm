---
import Section from "./Section.astro";
import Icon from "./Icon.astro";
import { phone, telegram, hours, address } from "../data/site";
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;
---
<Section id="hero" class="hero" rec="R-001">
  <div class="container hero__grid">
    <h1 class="hero__h1" data-rec="R-007">
      <span class="hero__big">Шкіра говорить про все<span class="hero__dot">.</span></span>
      <span class="hero__sub"> Медичний центр дерматології та косметології у Львові</span>
    </h1>
    <div class="desk">
      <p class="desk__label eyebrow">Запис до лікаря</p>
      <a class="desk__phone" href={`tel:${phone.tel}`} aria-label={`Подзвонити: ${phone.label}`}>
        <Icon name="phone" /><span>{phone.label}</span>
      </a>
      <div class="desk__btns">
        <a class="btn btn--primary" href={`tel:${phone.tel}`}>Записатися</a>
        <a class="btn btn--ghost" href={telegram}><Icon name="telegram" />Telegram</a>
      </div>
      <dl class="desk__facts">
        <div><dt>Графік</dt><dd>
          <span>Пн–пт {hours[0].time}</span><span>Сб {hours[1].time}</span><span>Нд — {hours[2].time}</span>
        </dd></div>
        <div><dt>Адреса</dt><dd><span>{address.line}</span><span>м. {address.city}</span></dd></div>
      </dl>
    </div>
    <figure class="hero__portrait">
      <img src={`${base}/img/bilyk-500.webp`} width="500" height="500" alt="Білик Леся Євгенівна, засновниця та головна лікарка центру" decoding="async" />
      <figcaption>Білик Леся Євгенівна<br /><span>Засновниця та головна лікарка, дерматовенеролог вищої категорії, 32 роки досвіду</span></figcaption>
    </figure>
  </div>
</Section>
<style>
  :global(.hero) { padding-top: var(--s4); padding-bottom: var(--s5); }
  .hero__grid { display: grid; gap: var(--s4); grid-template-columns: minmax(0, 1fr); }
  .hero__h1 { font-weight: 700; }
  .hero__big { display: block; font-size: var(--fs-h1); line-height: .96; letter-spacing: -.035em; color: var(--color-text); }
  .hero__dot { color: var(--color-accent); display: inline-block; transform-origin: 50% 82%; position: relative; font-size: 1.12em; line-height: 0; }
  .hero__dot::after { content: ""; position: absolute; left: 50%; bottom: .06em; width: .13em; height: .13em; margin-left: -.065em; border-radius: 50%; border: 2px solid var(--color-accent); opacity: 0; pointer-events: none; }
  .hero__sub { display: block; margin-top: var(--s3); font: 500 var(--fs-h1-sub)/1.2 var(--font-display); letter-spacing: -.01em; color: var(--color-brand); max-width: 24ch; }
  .desk { display: grid; gap: var(--s2); padding: var(--s3); background: var(--color-surface); border: 1px solid var(--color-hair); border-top: 3px solid var(--color-accent); border-radius: var(--radius); }
  .desk__phone { display: inline-flex; align-items: center; gap: .75rem; text-decoration: none; font: 600 clamp(1.75rem, 1.2rem + 2vw, 2.5rem)/1 var(--font-display); font-variant-numeric: tabular-nums; letter-spacing: -.01em; color: var(--color-text); min-height: 48px; }
  .desk__phone :global(.ico) { width: .8em; height: .8em; color: var(--color-accent); flex: none; }
  .desk__phone:hover span { color: var(--color-brand); }
  .desk__btns { display: grid; gap: .75rem; }
  .desk__facts { margin: var(--s1) 0 0; display: grid; gap: var(--s2); border-top: 1px solid var(--color-hair); padding-top: var(--s2); font-size: .9375rem; }
  .desk__facts > div { display: grid; gap: .25rem; }
  .desk__facts dt { color: var(--color-muted); font-size: var(--fs-small); }
  .desk__facts dd { margin: 0; display: flex; flex-wrap: wrap; column-gap: 1rem; font-variant-numeric: tabular-nums; }
  .hero__portrait { display: none; margin: 0; }
  @media (min-width: 900px) {
    :global(.hero) { padding-top: var(--s5); padding-bottom: var(--s6); }
    .hero__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 24px; row-gap: var(--s5); }
    .hero__h1 { grid-column: 1 / -1; }
    .hero__sub { max-width: none; margin-top: var(--s4); }
    .desk { grid-column: 1 / 9; grid-row: 2; align-self: end; align-content: start; grid-template-columns: 1fr auto; align-items: end; column-gap: var(--s4); padding: var(--s4); }
    .desk__label { grid-column: 1 / -1; }
    .desk__btns { grid-template-columns: auto auto; align-self: center; }
    .desk__facts { grid-column: 1 / -1; grid-template-columns: 1fr 1fr; }
    .hero__portrait { display: block; grid-column: 9 / -1; grid-row: 2; align-self: end; position: relative; }
    .hero__portrait img { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 15%; background: #DDE3EA; border-radius: var(--radius); }
    .hero__portrait figcaption { margin-top: var(--s1); font-size: var(--fs-small); font-weight: 600; line-height: 1.35; }
    .hero__portrait figcaption span { font-weight: 400; color: var(--color-muted); }
  }
  @media (min-width: 1360px) { .hero__portrait { margin-top: -14rem; } .desk { align-self: start; } }
  /* Motion: the brand dot "comes into focus" once. Text of H1 is visible immediately. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__dot { animation: dot-focus 700ms 200ms var(--ease-out) both; }
    .hero__dot::after { animation: dot-ring 900ms 500ms var(--ease-out) both; }
  }
  @media (prefers-reduced-motion: no-preference) and (max-width: 700px) { .hero__dot::after { animation: none; } }
  @keyframes dot-focus { from { transform: scale(.6); } to { transform: scale(1); } }
  @keyframes dot-ring { 0% { opacity: .7; transform: scale(1); } 100% { opacity: 0; transform: scale(5); } }
</style>
