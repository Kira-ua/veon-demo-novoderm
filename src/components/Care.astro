---
import Section from "./Section.astro";
import FutureLink from "./FutureLink.astro";
import { brands } from "../data/site";
---
<Section id="care" class="care" label="Догляд вдома" rec="R-005">
  <div class="container care__grid">
    <div class="care__head">
      <p class="eyebrow">Косметика для догляду</p>
      <h2>Догляд вдома<span class="dot">.</span></h2>
      <p class="care__lead">Центр — офіційний партнер брендів, з якими працюють лікарі. Підбір засобів — на консультації.</p>
      <FutureLink note="Розділ у розробці">Магазин</FutureLink>
    </div>
    <ul class="care__brands">
      {brands.map((b) => <li>{b}</li>)}
    </ul>
  </div>
</Section>
<style>
  :global(.care) { padding-block: var(--s6); border-top: 1px solid var(--color-hair); }
  .care__grid { display: grid; gap: var(--s5); }
  .care__head { display: grid; gap: var(--s3); justify-items: start; align-content: start; }
  .care__lead { font-size: var(--fs-lead); color: var(--color-muted); max-width: 30rem; }
  .care__brands { list-style: none; margin: 0; padding: 0; display: grid; }
  .care__brands li { font: 600 clamp(2rem, 1.2rem + 3.6vw, 4rem)/1.1 var(--font-display); letter-spacing: -.025em; padding: .45em 0; border-bottom: 1px solid var(--color-hair); color: var(--color-brand); }
  .care__brands li:first-child { border-top: 1px solid var(--color-hair); }
  @media (min-width: 900px) {
    .care__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 24px; align-items: start; }
    .care__head { grid-column: 1 / 5; position: sticky; top: calc(var(--header-h) + var(--s3)); }
    .care__brands { grid-column: 6 / -1; }
  }
</style>
