---
import Section from "./Section.astro";
import FutureLink from "./FutureLink.astro";
import { doctors, docUa } from "../data/site";
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;
---
<Section id="doctors" class="doc" label="Лікарі центру" rec="R-004">
  <div class="container" data-reveal>
    <div class="doc__spread">
      <figure class="doc__portrait">
        <img src={`${base}/img/bilyk-500.webp`} width="500" height="500" loading="lazy" decoding="async" alt="Білик Леся Євгенівна, засновниця та головна лікарка центру" />
      </figure>
      <div class="doc__text">
        <p class="eyebrow">Засновниця та головна лікарка</p>
        <h2>Центр, який веде лікар<span class="dot">.</span></h2>
        <p class="doc__lead">Білик Леся Євгенівна — дерматовенеролог вищої категорії, 32 роки досвіду, сертифікований тренер компанії IPSEN. Центр працює за ліцензією з 2010 року.</p>
      </div>
      <dl class="doc__facts">
        <div><dt>досвіду у засновниці центру</dt><dd><span>32</span> роки</dd></div>
        <div><dt>центр працює за ліцензією з</dt><dd><span>2010</span> року</dd></div>
        <div><dt>Рейтинг на doc.ua · 379 відгуків</dt><dd><span>5.0</span></dd></div>
      </dl>
    </div>
  </div>
  <div class="doc__rail" role="region" aria-label="Лікарі центру: прокрутіть горизонтально" tabindex="0">
    <ul class="doc__list">
      {doctors.map((d) => (
        <li class="card">
          <img src={`${base}/img/${d.img}.webp`} width={d.w} height={d.h} loading="lazy" decoding="async" alt={`${d.name}, ${d.role.charAt(0).toLowerCase()}${d.role.slice(1)}`} />
          <h3 class="card__name">{d.name}</h3>
          <p class="card__role">{d.role}</p>
          {d.exp && <p class="card__exp">{d.exp}</p>}
        </li>
      ))}
    </ul>
  </div>
  <div class="container doc__more"><FutureLink note="Розділ у розробці">Усі спеціалісти</FutureLink></div>
</Section>
<style>
  :global(.doc) { padding-block: var(--s6); overflow: clip; }
  .doc__spread { display: grid; gap: var(--s4); margin-bottom: var(--s5); }
  .doc__portrait { margin: 0; max-width: 20rem; }
  .doc__portrait img { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 15%; background: #DDE3EA; border-radius: var(--radius); }
  .doc__text { display: grid; gap: var(--s3); align-content: center; }
  .doc__text h2 { max-width: 14ch; }
  .doc__lead { font-size: var(--fs-lead); max-width: 36rem; }
  .doc__facts { margin: 0; display: grid; gap: var(--s3); }
  .doc__facts > div { border-top: 1px solid var(--color-hair); padding-top: var(--s2); display: grid; gap: .25rem; }
  .doc__facts dd { margin: 0; order: -1; font: 500 1.125rem var(--font-body); color: var(--color-muted); }
  .doc__facts dd span { font: 700 clamp(2.75rem, 1.5rem + 4vw, 4.5rem)/1 var(--font-display); letter-spacing: -.03em; color: var(--color-brand); }
  .doc__facts dt { color: var(--color-muted); font-size: .9375rem; }
  .doc__facts a { color: var(--color-brand); text-underline-offset: 4px; display: inline-flex; min-height: 24px; }
  .doc__facts a:hover { color: var(--color-accent); }
  .doc__rail { overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--space); padding-inline: var(--space); overscroll-behavior-x: contain; scrollbar-width: thin; padding-bottom: var(--s2); }
  .doc__list { list-style: none; margin: 0 auto; padding: 0; display: flex; gap: var(--s3); width: max-content; max-width: none; }
  .card { width: min(72vw, 17rem); scroll-snap-align: start; display: grid; gap: .35rem; align-content: start; }
  .card img { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 18%; background: #DDE3EA; border-radius: var(--radius); margin-bottom: .5rem; }
  .card__name { font-size: 1.1875rem; line-height: 1.2; font-weight: 600; }
  .card__role { font-size: .9375rem; color: var(--color-muted); }
  .card__exp { font-size: var(--fs-small); font-weight: 600; color: var(--color-brand); }
  .doc__more { margin-top: var(--s3); }
  @media (min-width: 900px) {
    .doc__spread { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 24px; }
    .doc__portrait { display: none; }
    .doc__text { grid-column: 1 / 8; }
    .doc__facts { grid-column: 9 / -1; }
    .doc__lead { font-size: 1.625rem; line-height: 1.35; max-width: 42rem; }
    .card { width: 17rem; }
  }
  @media (min-width: 1500px) { .doc__list { margin-inline: auto; } }
</style>
